<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:orientation="vertical">

    <!-- Header and controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_green_dark"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:minWidth="0dp"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:text="@string/back"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            app:rippleColor="@color/navigation_ripple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/loan_history_title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_statistic"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadStatement"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/download_statement"
            android:textColor="@color/brand_gold"
            android:textSize="@dimen/text_body"
            app:cornerRadius="@dimen/button_corner_radius"
            app:rippleColor="@color/navigation_ripple"
            app:strokeColor="@color/brand_gold"
            app:strokeWidth="@dimen/card_stroke_width" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:boxBackgroundColor="@color/surface_input"
            app:boxStrokeColor="@color/brand_gold"
            app:hintTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoanSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_by_reason"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <Spinner
            android:id="@+id/spinnerLoanSort"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_spinner"
            android:popupBackground="@color/surface_card"
            android:spinnerMode="dropdown"
            android:contentDescription="@string/loan_sort_options" />

        <Spinner
            android:id="@+id/spinnerLoanFilter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_spinner"
            android:popupBackground="@color/surface_card"
            android:spinnerMode="dropdown"
            android:contentDescription="@string/loan_filter_options" />

    </LinearLayout>

    <!-- Loan list state container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_primary">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLoans"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_lg"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <ProgressBar
            android:id="@+id/progressLoanHistory"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_gravity="center"
            android:contentDescription="@string/loading_loan_history"
            android:indeterminateTint="@color/brand_green"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvLoanHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:text="@string/loan_history_empty"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_section_title"
            android:visibility="gone" />

    </FrameLayout>

    <include
        layout="@layout/component_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>