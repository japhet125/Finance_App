<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/section_spacing">

    <!-- Section heading -->
    <TextView
        android:id="@+id/txtStatisticsSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_14"
        android:text="@string/dashboard_activity_overview"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_label"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false">

        <!-- Total Requested -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/statistics_card_height"
            android:layout_columnWeight="1"
            android:layout_marginEnd="@dimen/statistics_grid_half_gap"
            android:layout_marginBottom="@dimen/spacing_12"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/statistics_card_corner_radius"
            app:cardElevation="@dimen/card_elevation_primary"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_total_requested"
                    android:textSize="@dimen/text_amount" />

                <TextView
                    android:id="@+id/txtTotalRequestedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/dashboard_total_requested"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/txtTotalRequested"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/placeholder_zero_currency"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_amount"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Approved Amount -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/statistics_card_height"
            android:layout_columnWeight="1"
            android:layout_marginStart="@dimen/statistics_grid_half_gap"
            android:layout_marginBottom="@dimen/spacing_12"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/statistics_card_corner_radius"
            app:cardElevation="@dimen/card_elevation_primary"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_approved"
                    android:textSize="@dimen/text_amount" />

                <TextView
                    android:id="@+id/txtApprovedAmountTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/dashboard_approved_amount"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/txtApprovedAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/placeholder_zero_currency"
                    android:textColor="@color/brand_green"
                    android:textSize="@dimen/text_amount"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pending Requests -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/statistics_card_height"
            android:layout_columnWeight="1"
            android:layout_marginEnd="@dimen/statistics_grid_half_gap"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/statistics_card_corner_radius"
            app:cardElevation="@dimen/card_elevation_primary"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_pending"
                    android:textSize="@dimen/text_amount" />

                <TextView
                    android:id="@+id/txtPendingLoansTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/dashboard_pending_requests"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/txtPendingLoans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/placeholder_zero"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_statistic"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Rejected Requests -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/statistics_card_height"
            android:layout_columnWeight="1"
            android:layout_marginStart="@dimen/statistics_grid_half_gap"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/statistics_card_corner_radius"
            app:cardElevation="@dimen/card_elevation_primary"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_rejected"
                    android:textSize="@dimen/text_amount" />

                <TextView
                    android:id="@+id/txtRejectedLoansTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/dashboard_rejected_requests"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/txtRejectedLoans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/placeholder_zero"
                    android:textColor="@color/brand_gold"
                    android:textSize="@dimen/text_statistic"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </GridLayout>

    <!-- Notifications Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUnreadNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_14"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="@dimen/statistics_card_corner_radius"
        app:cardElevation="@dimen/card_elevation_primary"
        app:strokeColor="@color/surface_stroke"
        app:strokeWidth="@dimen/card_stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_18">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_notification"
                android:textSize="@dimen/text_loan_limit" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_14"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtUnreadNotificationsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_notifications"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_card_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNotificationsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:text="@string/dashboard_notification_description"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtUnreadNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notification_count"
                android:minWidth="@dimen/notification_badge_min_width"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_10"
                android:paddingTop="@dimen/spacing_7"
                android:paddingEnd="@dimen/spacing_10"
                android:paddingBottom="@dimen/spacing_7"
                android:text="@string/placeholder_zero"
                android:textColor="@color/background_primary"
                android:textSize="@dimen/text_regular"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>