<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/card_corner_radius_primary"
    app:cardElevation="@dimen/card_elevation_primary"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- Transaction Amount -->
        <TextView
            android:id="@+id/txtTransactionAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transaction_amount_default"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title"
            android:textStyle="bold" />

        <!-- Previous Balance -->
        <TextView
            android:id="@+id/txtPreviousBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/previous_balance_default"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- New Balance -->
        <TextView
            android:id="@+id/txtNewBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/new_balance_default"
            android:textColor="@color/brand_green"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_stroke_width"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@color/surface_divider" />

        <!-- Payment Date -->
        <TextView
            android:id="@+id/txtPaymentDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_date_default"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_regular" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>