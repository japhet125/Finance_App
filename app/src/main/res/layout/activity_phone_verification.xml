<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phone_verification_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_statistic"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtOtpInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:text="@string/phone_verification_instruction"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:boxBackgroundColor="@color/surface_input"
        app:boxStrokeColor="@color/brand_green"
        app:hintTextColor="@color/input_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/phone_number_hint"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/input_hint" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendOtp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/send_verification_code"
        android:textSize="@dimen/text_body"
        app:backgroundTint="@color/brand_green"
        app:cornerRadius="@dimen/button_corner_radius"
        app:rippleColor="@color/navigation_ripple" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        app:boxBackgroundColor="@color/surface_input"
        app:boxStrokeColor="@color/brand_green"
        app:hintTextColor="@color/input_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOtpCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/otp_code_hint"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="6"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/input_hint" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyOtp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/verify"
        android:textSize="@dimen/text_body"
        app:backgroundTint="@color/brand_green"
        app:cornerRadius="@dimen/button_corner_radius"
        app:rippleColor="@color/navigation_ripple" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/back"
        android:textColor="@color/brand_green"
        android:textSize="@dimen/text_body"
        app:cornerRadius="@dimen/button_corner_radius"
        app:rippleColor="@color/navigation_ripple"
        app:strokeColor="@color/brand_green" />

</LinearLayout>