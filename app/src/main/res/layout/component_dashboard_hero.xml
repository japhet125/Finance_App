<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Greeting section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginBottom="@dimen/section_spacing"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_heading" />

        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:text=""
            android:textColor="@color/brand_green"
            android:textSize="@dimen/text_regular" />

    </LinearLayout>

    <!-- Credit Score Hero Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCreditScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/surface_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:id="@+id/txtCreditScoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREDIT SCORE"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/txtCreditScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_18"
                android:text="500"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_credit_score"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCreditScoreRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="Poor"
                android:textColor="@color/brand_gold"
                android:textSize="@dimen/text_credit_rating"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressCreditScore"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_height"
                android:layout_marginTop="@dimen/spacing_22"
                android:max="100"
                android:progress="36"
                app:indicatorColor="@color/brand_green"
                app:trackColor="@color/surface_divider"
                app:trackCornerRadius="@dimen/spacing_xs"
                app:trackThickness="@dimen/progress_height" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="300"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="850"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Borrower Progress Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBorrowerProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/surface_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/txtBorrowerLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_borrower_badge"
                android:paddingStart="@dimen/spacing_14"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_14"
                android:paddingBottom="@dimen/spacing_sm"
                android:text="🏅 New Borrower"
                android:textColor="@color/brand_green"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtBorrowerProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="Progress to Bronze"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBorrowerLevel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_height"
                android:layout_marginTop="@dimen/spacing_12"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/brand_gold"
                app:trackColor="@color/surface_divider"
                app:trackCornerRadius="@dimen/spacing_xs"
                app:trackThickness="@dimen/progress_height" />

            <TextView
                android:id="@+id/txtNextLevelProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:text="3 loans remaining"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Identity Badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIdentityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/surface_stroke"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/txtIdentityBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_18"
            android:text="Identity Verification"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>