<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLoanSummary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/section_spacing"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/card_corner_radius_primary"
    app:cardElevation="@dimen/card_elevation_primary"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_22">

        <!-- Section title -->
        <TextView
            android:id="@+id/txtLoanSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOAN OVERVIEW"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- Available loan limit -->
        <TextView
            android:id="@+id/txtLoanLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Available Loan Limit: $0"
            android:textColor="@color/brand_green"
            android:textSize="@dimen/text_loan_limit"
            android:textStyle="bold" />

        <!-- Request loan button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestLoan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_18"
            android:text="Request Loan"
            android:textAllCaps="false"
            android:textColor="@color/background_primary"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_gold"
            app:cornerRadius="@dimen/button_corner_radius"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_10"
            app:iconTint="@color/background_primary" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="@dimen/spacing_22"
            android:layout_marginBottom="@dimen/section_spacing"
            android:background="@color/surface_divider" />

        <!-- Auto Pay header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtAutoPayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next Payment"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAutoPayBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_autopay_badge"
                android:paddingStart="@dimen/spacing_12"
                android:paddingTop="@dimen/spacing_6"
                android:paddingEnd="@dimen/spacing_12"
                android:paddingBottom="@dimen/spacing_6"
                android:text="AUTO PAY"
                android:textColor="@color/brand_green"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Auto Pay status -->
        <TextView
            android:id="@+id/txtAutoPayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14"
            android:text="Status: No Active Auto Pay"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_regular" />

        <!-- Next payment date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment Date"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/txtAutoPayNextDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not scheduled"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_regular"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Next payment amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment Amount"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/txtAutoPayAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="@color/brand_gold"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>