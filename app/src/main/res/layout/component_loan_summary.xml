<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLoanSummary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    app:cardBackgroundColor="#171A16"
    app:cardCornerRadius="@dimen/card_corner_radius_primary"
    app:cardElevation="@dimen/card_elevation_primary"
    app:strokeColor="#2D342A"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Section title -->
        <TextView
            android:id="@+id/txtLoanSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOAN OVERVIEW"
            android:textAllCaps="true"
            android:textColor="#A9A9A9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <!-- Available loan limit -->
        <TextView
            android:id="@+id/txtLoanLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Available Loan Limit: $0"
            android:textColor="#8CBF5A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Request loan button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestLoan"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="Request Loan"
            android:textAllCaps="false"
            android:textColor="#0D0F0D"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#C9A227"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="#0D0F0D" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:background="#30352E" />

        <!-- Auto Pay header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtAutoPayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next Payment"
                android:textColor="#F8F8F8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAutoPayBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_autopay_badge"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="AUTO PAY"
                android:textColor="#8CBF5A"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Auto Pay status -->
        <TextView
            android:id="@+id/txtAutoPayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Status: No Active Auto Pay"
            android:textColor="#A9A9A9"
            android:textSize="15sp" />

        <!-- Next payment date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment Date"
                android:textColor="#777C74"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtAutoPayNextDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not scheduled"
                android:textColor="#F8F8F8"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Next payment amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment Amount"
                android:textColor="#777C74"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtAutoPayAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="#C9A227"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>