<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/card_corner_radius_primary"
    app:cardElevation="@dimen/card_elevation_primary"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- User name -->
        <TextView
            android:id="@+id/txtAdminUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_user_name_default"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title"
            android:textStyle="bold" />

        <!-- Email -->
        <TextView
            android:id="@+id/txtAdminUserEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/admin_user_email_default"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Phone -->
        <TextView
            android:id="@+id/txtAdminUserPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/admin_user_phone_default"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_stroke_width"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@color/surface_divider" />

        <!-- Role -->
        <TextView
            android:id="@+id/txtAdminUserRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_user_role_default"
            android:textColor="@color/brand_green"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <!-- Credit score -->
        <TextView
            android:id="@+id/txtAdminUserCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/admin_user_credit_default"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Identity status -->
        <TextView
            android:id="@+id/txtAdminUserIdentity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/admin_user_identity_default"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>