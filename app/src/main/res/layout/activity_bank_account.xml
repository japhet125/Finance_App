<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:minWidth="0dp"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:text="@string/back"
            android:textColor="@color/brand_green"
            app:rippleColor="@color/navigation_ripple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:text="@string/bank_account_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/surface_input"
            app:boxStrokeColor="@color/brand_green"
            app:hintTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBankName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bank_name"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:boxBackgroundColor="@color/surface_input"
            app:boxStrokeColor="@color/brand_green"
            app:hintTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccountType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bank_account_type"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:boxBackgroundColor="@color/surface_input"
            app:boxStrokeColor="@color/brand_green"
            app:hintTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoutingNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/routing_number_bank_code"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:boxBackgroundColor="@color/surface_input"
            app:boxStrokeColor="@color/brand_green"
            app:hintTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAccountNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bank_account_number"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <Spinner
            android:id="@+id/spinnerBankCountry"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_spinner"
            android:popupBackground="@color/surface_card"
            android:spinnerMode="dropdown"
            android:contentDescription="@string/bank_country" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:boxBackgroundColor="@color/surface_input"
            app:boxStrokeColor="@color/surface_stroke"
            app:hintTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:hint="@string/currency"
                android:textColor="@color/text_secondary"
                android:textColorHint="@color/input_hint" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBank"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/save_bank_account"
            android:textSize="@dimen/text_body"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="@dimen/button_corner_radius" />

    </LinearLayout>

</ScrollView>