<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/mobile_money_title"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerMobileMoneyCountry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/mobile_money_country" />

        <Spinner
            android:id="@+id/spinnerMobileMoneyProvider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/mobile_money_provider" />

        <EditText
            android:id="@+id/etMobileMoneyPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:hint="@string/mobile_money_phone"
            android:inputType="phone" />

        <EditText
            android:id="@+id/etMobileMoneyName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:hint="@string/mobile_money_account_holder"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etMobileMoneyCurrency"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:hint="@string/currency" />

        <Button
            android:id="@+id/btnSaveMobileMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save_mobile_money" />

    </LinearLayout>
</ScrollView>