<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_4xl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:minWidth="0dp"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:text="@string/back"
            android:textColor="@color/brand_green"
            android:textSize="@dimen/text_body"
            app:rippleColor="@color/navigation_ripple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:text="@string/loan_request_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <!-- Loan amount -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLoanAmount"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/loan_amount"
            app:boxBackgroundColor="@color/surface_input"
            app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
            app:boxStrokeColor="@color/brand_green"
            app:hintTextColor="@color/input_hint"
            app:prefixText="@string/currency_input_prefix"
            app:prefixTextColor="@color/input_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoanAmount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/input_text"
                android:textSize="@dimen/text_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Loan reason -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLoanReason"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/loan_reason"
            app:boxBackgroundColor="@color/surface_input"
            app:boxCornerRadiusBottomEnd="@dimen/button_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/button_corner_radius"
            app:boxStrokeColor="@color/brand_green"
            app:hintTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoanReason"
                android:layout_width="match_parent"
                android:layout_height="@dimen/multiline_input_height"
                android:gravity="top|start"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minLines="4"
                android:paddingTop="@dimen/spacing_md"
                android:textColor="@color/input_text"
                android:textSize="@dimen/text_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/payment_plan"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPaymentPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbWeekly10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/payment_plan_weekly_10"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                app:buttonTint="@color/brand_green" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbWeekly14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/payment_plan_weekly_14"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                app:buttonTint="@color/brand_green" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbMonthly12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/payment_plan_monthly_12"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                app:buttonTint="@color/brand_green" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbOneTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/payment_plan_one_time"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                app:buttonTint="@color/brand_green" />

        </RadioGroup>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbAutoPay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/enable_auto_pay"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            app:buttonTint="@color/brand_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitLoan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/submit_loan_request"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            app:backgroundTint="@color/brand_green"
            app:cornerRadius="@dimen/button_corner_radius"
            app:rippleColor="@color/navigation_ripple" />

    </LinearLayout>

</ScrollView>