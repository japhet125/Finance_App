<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/admin_analytics_title"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTotalUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="@string/admin_total_users_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTotalLoans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="@string/admin_total_loans_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtApprovedLoans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="@string/admin_approved_loans_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOverdueLoans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="@string/admin_overdue_loans_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTotalLoaned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="@string/admin_total_loaned_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTotalPayments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="@string/admin_total_payments_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAverageCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="@string/admin_average_credit_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVerifiedUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_verified_users_default"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtFlaggedUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_flagged_users_default"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtRejectedLoans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_rejected_loans_default"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtOutstandingBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_outstanding_balance_default"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLoanStatusChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/view_loan_status_chart" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieLoansStatus"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="24dp" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barPayments"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>